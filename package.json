{
  "name": "sitedoc",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:integration": "pnpm --filter @sitedoc/api test:integration",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "db:migrate": "pnpm --filter @sitedoc/db migrate",
    "db:seed": "pnpm --filter @sitedoc/db seed",
    "db:studio": "pnpm --filter @sitedoc/db studio",
    "db:generate": "pnpm --filter @sitedoc/db generate",
    "e2e": "pnpm --filter @sitedoc/e2e run e2e",
    "e2e:install": "pnpm --filter @sitedoc/e2e run e2e:install"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "turbo": "^2.8.12"
  },
  "dependencies": {
    "dxf-parser": "^1.1.2"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom@<0.8.15": "^0.8.15",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "fast-uri@>=3.0.0 <3.1.7": "^3.1.7",
      "@fastify/busboy@<3.2.1": "^3.2.1"
    }
  }
}

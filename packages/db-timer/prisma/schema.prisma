// Timer-modul — Fase 3
// Isolert datalag: eget postgres-schema "timer", egen Prisma-klient.
// Samme PostgreSQL-instans som packages/db, ingen FK-relasjoner på tvers.
// Cross-package-FK håndteres som svake String-felt uten Prisma @relation
// (samme mønster som db-maskin).

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/timer-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["timer"]
}

// ==========================================================================
//  Lonnsart — datadrevet katalog per Organization (Nivå 1+2+3 per timer.md)
// ==========================================================================

model Lonnsart {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id") // svak FK → organizations.id
  type             String   // "ordinaer" | "fravaer" | "feriepenger" | "diett"
  kode             String?  // Eksport-kode (Poweroffice/Visma/etc.). NULL hvis kunde ikke har valgt eksport-system.
  navn             String
  prisMotKunde     Decimal? @map("pris_mot_kunde") @db.Decimal(12, 2)
  internkostnad    Decimal? @db.Decimal(12, 2)
  sats             Decimal? @db.Decimal(12, 2) // Flat utbetaling (diett, km-godtgjørelse) — null for time-lønnsarter
  satsEnhet        String?  @map("sats_enhet") // "per_dag" | "per_natt" | "per_km" | "per_time"
  skalEksporteres  Boolean  @default(true) @map("skal_eksporteres")
  tvungenKommentar Boolean  @default(false) @map("tvungen_kommentar")
  rekkefolge       Int      @default(0)
  aktiv            Boolean  @default(true)
  // Variant B (2026-06-05): auto-valgt lønnsart på ny timer-rad når sedelen
  // er tom (ingen forrige rad å arve fra). Maks én true per organizationId —
  // håndheves i lonnsart.settStandard (nullstiller andre i samme transaksjon).
  erStandardvalg   Boolean  @default(false) @map("er_standardvalg")
  // ③a (2026-07-05): strukturert overtid-klassifisering. null = ikke overtid;
  // 50 = 50 %; 100 = 100 %. Erstatter fritekst-navne-match i mobil auto-gen.
  // Regelen som bruker feltet er isolert i @sitedoc/shared lonnsregel.ts.
  overtidsnivaa    Int?     @map("overtidsnivaa")
  seedNivaa        Int?     @map("seed_nivaa") // 1, 2 eller null (3 = egendefinert)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  sheetTimer SheetTimer[]

  @@unique([organizationId, kode], name: "uq_lonnsart_kode_per_org", map: "uq_lonnsart_kode_per_org")
  @@index([organizationId, aktiv])
  @@map("lonnsarter")
  @@schema("timer")
}

// ==========================================================================
//  Aktivitet — datadrevet katalog per Organization (ProAdm-kostnadsdimensjon)
// ==========================================================================

model Aktivitet {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  kode           String?
  navn           String
  internkostnad  Decimal? @db.Decimal(12, 2)
  prisMotKunde   Decimal? @map("pris_mot_kunde") @db.Decimal(12, 2)
  aktiv          Boolean  @default(true)
  seedNivaa      Int?     @map("seed_nivaa")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  dailySheets DailySheet[]
  sheetTimer  SheetTimer[]

  @@unique([organizationId, kode], name: "uq_aktivitet_kode_per_org", map: "uq_aktivitet_kode_per_org")
  @@index([organizationId, aktiv])
  @@map("aktiviteter")
  @@schema("timer")
}

// ==========================================================================
//  Tillegg — datadrevet katalog per Organization (overtidsmat, nattillegg, ...)
// ==========================================================================

model Tillegg {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  kode             String?
  navn             String
  type             String   // "avhuking" | "antall"
  prisMotKunde     Decimal? @map("pris_mot_kunde") @db.Decimal(12, 2)
  internkostnad    Decimal? @db.Decimal(12, 2)
  skalEksporteres  Boolean  @default(true) @map("skal_eksporteres")
  tvungenKommentar Boolean  @default(false) @map("tvungen_kommentar")
  rekkefolge       Int      @default(0)
  aktiv            Boolean  @default(true)
  seedNivaa        Int?     @map("seed_nivaa")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  sheetTillegg SheetTillegg[]

  @@unique([organizationId, kode], name: "uq_tillegg_kode_per_org", map: "uq_tillegg_kode_per_org")
  @@index([organizationId, aktiv])
  @@map("tillegg")
  @@schema("timer")
}

// ==========================================================================
//  ExpenseCategory — utleggskategorier per Organization
// ==========================================================================

model ExpenseCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  navn           String
  // Utleggs-ordningsmodell (U1, 2026-08-08; justert 2026-08-11): firma-katalogen
  // eier ordningens EKSISTENS og default. Lukket enum "lonnstillegg" | "utlegg" |
  // "fakturert" — validert i app-lag (@sitedoc/shared erGyldigOrdning) + DB-CHECK i
  // migreringen. "lonnstillegg" het tidligere "sats" (homonym-fiks). "fakturert"
  // beholdes for historikk men er ikke lenger valgbar (app-lag avviser på skriv).
  // Prosjekt kan overstyre via ProsjektOrdningOverstyring; oppslag alltid
  // overstyring ?? denne. Default = "utlegg" (utleggskategorier er refusjon).
  ordning        String   @default("utlegg")
  // Satsbasert (2026-08-11): kategorien beregnes ETTER en sats (kjøregodtgjørelse,
  // diett — «statens satser»). ENDRER IKKE bærer/ordning/eksport — styrer UI
  // (satsfelt/beregningshjelp, senere) + følger eksport som metadata.
  satsbasert     Boolean  @default(false) @map("satsbasert")
  // Mulig skattepliktig (2026-08-11): firma-admin-flagg. SiteDoc registrerer
  // GRUNNLAG, aldri avgjørelse — skatteberegning er ut av scope. Følger eksporten
  // per linje så regnskap ser hvilke som krever vurdering.
  muligSkattepliktig Boolean @default(false) @map("mulig_skattepliktig")
  aktiv          Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sheetUtlegg   SheetUtlegg[]
  overstyringer ProsjektOrdningOverstyring[]

  @@index([organizationId])
  @@map("expense_categories")
  @@schema("timer")
}

// ==========================================================================
//  DailySheet — dagsseddel (hovedtabell)
//  Status-livssyklus: draft → sent → returned → accepted
// ==========================================================================

model DailySheet {
  id                  String    @id @default(uuid())
  clientUuid          String    @unique @map("client_uuid") // Klient-generert for idempotent upsert
  organizationId      String    @map("organization_id")
  userId              String    @map("user_id")
  registrertAvUserId  String    @map("registrert_av_user_id") // kan være ulik userId
  // T.1 (PR 1B, 2026-05-11) — projectId droppet. Dagsseddel eies av arbeider/firma.
  // Prosjekttilhørighet ligger nå på rad-nivå (SheetTimer.projectId).
  // Default-aktivitet for nye timer-rader. Selve kanon-eierskapet ligger på SheetTimer.aktivitetId per rad (vedtatt C9 2026-05-02).
  // Beholdes nullable for bakoverkompatibilitet og UX (kopieres til første rad ved opprettelse, kan overstyres per rad).
  aktivitetId         String?   @map("aktivitet_id")
  avdelingId          String?   @map("avdeling_id")
  byggeplassId        String?   @map("byggeplass_id")
  dato                DateTime  @db.Date
  startAt             DateTime? @map("start_at") @db.Timestamptz()
  endAt               DateTime? @map("end_at") @db.Timestamptz()
  pauseMin            Int       @default(0) @map("pause_min")
  // Pause-modell (vedtatt 2026-05-17): pauseFra/pauseTil definerer tidspunktet
  // for pausen. pauseMin beholdes som denormalisert sum for raskt oppslag.
  // Nullable: eksisterende sedler har ingen pause-vindu (kun pauseMin).
  pauseFra            String?   @map("pause_fra")
  pauseTil            String?   @map("pause_til")
  // Slice 4b-2 (2026-06-21): kilde for slutt-tiden.
  //   "bruker"  = arbeider satte/bekreftet tiden (normal «Slutt dag», manuell
  //               oppretting/redigering) → ingen kontroll-badge.
  //   "midnatt" = automatisk dag-grense fra midnatt-splitt (Slice 4a) → normalt,
  //               ingen badge.
  //   "system"  = system-gjettet tid (glemt-dag-gjenoppretting / maks-varighet)
  //               → kontroll-badge i attestering (ikke arbeider-bekreftet).
  sluttTidKilde       String    @default("bruker") @map("slutt_tid_kilde")
  status              String    @default("draft") // "draft" | "sent" | "returned" | "accepted"
  beskrivelse         String?   @db.Text
  lederKommentar      String?   @map("leder_kommentar") @db.Text
  syncStatus          String    @default("synced") @map("sync_status") // "pending" | "synced" | "conflict"
  syncedAt            DateTime? @map("synced_at") @db.Timestamptz()
  attestertAvUserId   String?   @map("attestert_av_user_id")
  attestertVed        DateTime? @map("attestert_ved") @db.Timestamptz()
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  aktivitet Aktivitet?     @relation(fields: [aktivitetId], references: [id], onDelete: Restrict)
  timer     SheetTimer[]
  tillegg   SheetTillegg[]
  maskiner  SheetMachine[]
  utlegg    SheetUtlegg[]

  @@unique([userId, dato])
  @@index([organizationId])
  @@index([organizationId, dato])
  @@index([organizationId, status])
  @@index([attestertAvUserId, attestertVed])
  @@index([byggeplassId, dato])
  @@index([avdelingId, dato])
  @@index([userId, syncStatus])
  @@map("daily_sheets")
  @@schema("timer")
}

// ==========================================================================
//  SheetTimer — timer-rader per dagsseddel (datadrevet via Lonnsart)
// ==========================================================================

model SheetTimer {
  id                    String   @id @default(uuid())
  sheetId               String   @map("sheet_id")
  lonnsartId            String   @map("lonnsart_id")
  // Per-rad aktivitet (C9 2026-05-02). Backfill ved migrasjon: parent.aktivitetId.
  // NOT NULL — alle nye rader må ha aktivitet. Klient sender alltid (default fra sedel).
  aktivitetId           String   @map("aktivitet_id")
  // T.2 (PR 1B, 2026-05-11) — Per-rad prosjekttilhørighet. NOT NULL etter backfill i PR 1A.
  // Svak FK uten @relation (A.20-mønster).
  projectId             String   @map("project_id")
  // T.2 — Per-rad byggeplass. Forblir nullable (A.30: byggeplass-NULL er gyldig).
  byggeplassId          String?  @map("byggeplass_id")
  // T.4 — Per-rad tid HH:MM. Server validerer fraTid < tilTid i PR 2.
  fraTid                String?  @map("fra_tid")
  tilTid                String?  @map("til_tid")
  // T.12 — Fritekst per rad: «hva jeg gjorde» på denne aktiviteten. Nullable,
  // additivt. Ingen index (fritekst-felt, ikke filtrerbart).
  beskrivelse           String?  @db.Text
  externalCostObjectId  String?  @map("external_cost_object_id") // svak FK → external_cost_objects (kjernen)
  // vehicleId (Fase 2 / T.10): kostnadsbærer for maskinvedlikehold — timene en
  // mekaniker fører på vedlikehold av en maskin attribueres til maskinen.
  // DISTINKT fra SheetMachine.vehicleId (drift/anleggstimer, jf. C.18). Svak FK
  // → maskin.equipment (db-maskin, A.20-mønster, ingen @relation). Nullable —
  // settes kun på interne verksted-rader. Org-validering i app-lag (§2.D).
  vehicleId             String?  @map("vehicle_id")
  timer                 Decimal  @db.Decimal(6, 2)
  // F5 (2026-07-14) — matpause-bærer: minutter lunsjpause denne raden trekker
  // (0 = ingen). Kun ÉN rad per sedel har pauseMin > 0 (kun-én-per-dag, flytt).
  // Klient-invariant: DailySheet.pauseMin = Σ(SheetTimer.pauseMin) — bevarer
  // maskin-kapasitetsregelen (validerMaskinUnderArbeid bruker sedel-nivå pauseMin
  // uendret). Additiv NOT NULL DEFAULT 0; eldre klient sender ikke feltet → 0.
  pauseMin              Int      @default(0) @map("pause_min")
  attestertSnapshot     Json?    @map("attestert_snapshot") // Pris-snapshot ved attestering (Fase 0 A.7) — inkluderer aktivitet-snapshot post-C9
  // T.3 — Per-rad attestering. "pending" | "attestert" | "returnert" | "erstattet".
  // (Norsk-konvensjon: "attestert" — CLAUDE.md skiller attestering fra godkjenning.)
  // T7-2b2 (2026-05-14): "erstattet" markerer original-rad som er overskrevet
  // ved firma-admin rediger-modus. parentRadId peker fra ny rad til original.
  attestertStatus       String?  @default("pending") @map("attestert_status")
  attestertAvUserId     String?  @map("attestert_av_user_id") // svak FK → users
  attestertVed          DateTime? @map("attestert_ved") @db.Timestamptz()
  // T7-2b2 — Svak selvreferanse til original-rad ved firma-admin rediger.
  // null = original rad eller helt ny rad. Ingen @relation (A.20-mønster).
  parentRadId           String?  @map("parent_rad_id")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  sheet     DailySheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  lonnsart  Lonnsart   @relation(fields: [lonnsartId], references: [id], onDelete: Restrict)
  aktivitet Aktivitet  @relation(fields: [aktivitetId], references: [id], onDelete: Restrict)

  @@index([sheetId])
  @@index([lonnsartId])
  @@index([aktivitetId])
  @@index([externalCostObjectId])
  @@index([projectId])
  @@index([byggeplassId])
  @@index([vehicleId])
  @@index([attestertStatus])
  @@index([parentRadId])
  @@map("sheet_timer")
  @@schema("timer")
}

// ==========================================================================
//  SheetTillegg — tillegg-rader per dagsseddel (datadrevet via Tillegg)
// ==========================================================================

model SheetTillegg {
  id                String   @id @default(uuid())
  sheetId           String   @map("sheet_id")
  tilleggId         String   @map("tillegg_id")
  // T.2 (PR 1B, 2026-05-11) — Per-rad prosjekttilhørighet. NOT NULL etter backfill i PR 1A.
  projectId         String   @map("project_id")
  antall            Decimal  @db.Decimal(6, 2)
  kommentar         String?  @db.Text
  attestertSnapshot Json?    @map("attestert_snapshot")
  // T.3 — Per-rad attestering. "pending" | "attestert" | "returnert" | "erstattet".
  // T7-2b2: "erstattet" + parentRadId markerer rediger-erstattede rader.
  attestertStatus   String?  @default("pending") @map("attestert_status")
  attestertAvUserId String?  @map("attestert_av_user_id") // svak FK → users
  attestertVed      DateTime? @map("attestert_ved") @db.Timestamptz()
  parentRadId       String?  @map("parent_rad_id") // T7-2b2 svak selvreferanse
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  sheet   DailySheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  tillegg Tillegg    @relation(fields: [tilleggId], references: [id], onDelete: Restrict)

  @@index([sheetId])
  @@index([tilleggId])
  @@index([projectId])
  @@index([attestertStatus])
  @@index([parentRadId])
  @@map("sheet_tillegg")
  @@schema("timer")
}

// ==========================================================================
//  SheetTilleggVedlegg — kvittering-/bilde-vedlegg på en tillegg-rad
//  (Funn #2, 2026-06-21). Arbeider legger ved kvittering (bilde/scan) på et
//  tillegg/utlegg. Flere vedlegg per rad. Lagring: server-lokal disk via
//  /upload (fileUrl = /uploads/...), IKKE S3 (jf. BACKLOG S3-drift-note).
//  sheetTilleggId er svak String-FK uten @relation (A.20 cross-modul-mønster).
// ==========================================================================

model SheetTilleggVedlegg {
  id             String   @id @default(uuid())
  sheetTilleggId String   @map("sheet_tillegg_id") // svak FK → sheet_tillegg (ingen @relation)
  fileUrl        String   @map("file_url")
  fileName       String   @map("file_name")
  mimeType       String   @map("mime_type")
  fileSize       Int      @map("file_size")
  gpsLat         Float?   @map("gps_lat")
  gpsLng         Float?   @map("gps_lng")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([sheetTilleggId])
  @@map("sheet_tillegg_vedlegg")
  @@schema("timer")
}

// ==========================================================================
//  SheetUtlegg — utleggs-/fakturert-rader per dagsseddel (U1, 2026-08-08)
//  Egen bærer atskilt fra SheetTillegg: beløp/mva/kvittering har ANDRE
//  semantikker enn antall/avhuking, og eksporten skiller på MODELL, ikke på et
//  flagg som kan glemmes. sats-ordninger bæres fortsatt av SheetTillegg.
//
//  ordningVedFoering er INTEGRITETSBÆRER, ikke bare revisjonsspor: insert
//  stempler utledet ordning (overstyring ?? firma-default) i samme transaksjon,
//  og CHECK-constrainten (migrering) håndhever beløps-regelen mot DET stempelet:
//    (fakturert AND belop IS NULL) OR (<>fakturert AND belop IS NOT NULL)
//  Feltet er IMMUTABELT etter insert — ordningsbytte = korreksjon (ny rad),
//  aldri mutasjon. projectId er svak FK → Project (kjernen, A.20-mønster).
// ==========================================================================

model SheetUtlegg {
  id                String   @id @default(uuid())
  sheetId           String   @map("sheet_id")
  projectId         String   @map("project_id") // svak FK → projects (kjernen, ingen @relation)
  expenseCategoryId String   @map("expense_category_id")
  // NULL kun når ordningVedFoering='fakturert' (håndhevet av CHECK). Refusjon
  // krone for krone for 'utlegg'.
  belop             Decimal? @db.Decimal(10, 2)
  // mva-sats snapshot per rad (regnskapsspørsmål — settes fra kategori i U2).
  mvaSats           Decimal? @map("mva_sats") @db.Decimal(5, 2)
  kommentar         String?  @db.Text
  // Utledet ordning stemplet ved insert. Immutabel. Se blokk-kommentar over.
  ordningVedFoering String   @map("ordning_ved_foering")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  sheet           DailySheet      @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  expenseCategory ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Restrict)

  @@index([sheetId])
  @@index([projectId])
  @@index([expenseCategoryId])
  @@map("sheet_utlegg")
  @@schema("timer")
}

// ==========================================================================
//  SheetUtleggVedlegg — kvittering-/bilde-vedlegg på en utlegg-rad (U1).
//  Speiler SheetTilleggVedlegg 1:1 (mønster 1: rad per fil, svak String-FK
//  uten @relation, samme feltsett). Lagring via /upload (fileUrl), ikke S3.
// ==========================================================================

model SheetUtleggVedlegg {
  id            String   @id @default(uuid())
  sheetUtleggId String   @map("sheet_utlegg_id") // svak FK → sheet_utlegg (ingen @relation)
  fileUrl       String   @map("file_url")
  fileName      String   @map("file_name")
  mimeType      String   @map("mime_type")
  fileSize      Int      @map("file_size")
  gpsLat        Float?   @map("gps_lat")
  gpsLng        Float?   @map("gps_lng")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([sheetUtleggId])
  @@map("sheet_utlegg_vedlegg")
  @@schema("timer")
}

// ==========================================================================
//  ProsjektOrdningOverstyring — firma-admin overstyrer en kategoris ordning
//  for ETT prosjekt (U1). Oppslag alltid: overstyring ?? ExpenseCategory.ordning
//  (delt utledningsfunksjon i @sitedoc/shared). Endring gjelder kun FREMOVER —
//  allerede førte rader beholder sitt ordningVedFoering-stempel. prosjektId er
//  svak FK → Project (kjernen, A.20-mønster, ingen @relation).
// ==========================================================================

model ProsjektOrdningOverstyring {
  id                String   @id @default(uuid())
  prosjektId        String   @map("prosjekt_id") // svak FK → projects (kjernen)
  expenseCategoryId String   @map("expense_category_id")
  ordning           String
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  expenseCategory ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Cascade)

  @@unique([prosjektId, expenseCategoryId], name: "uq_overstyring_prosjekt_kategori", map: "uq_overstyring_prosjekt_kategori")
  @@index([expenseCategoryId])
  @@map("prosjekt_ordning_overstyring")
  @@schema("timer")
}

// ==========================================================================
//  SheetMachine — maskinbruk-rader per dagsseddel (C9 2026-05-02)
//  vehicleId er svak FK til db-maskin Equipment (per A.20 cross-package-mønster)
//  Soft-skjul i UI: seksjon vises kun når Maskin-modul er aktivert for firmaet
// ==========================================================================

model SheetMachine {
  id                String   @id @default(uuid())
  sheetId           String   @map("sheet_id")
  // Del B pkt 1 (device-funn 2026-08-08) — svak FK → sheet_timer.id (samme
  // skjema, ingen @relation, A.20-mønster). Kobler maskin-raden til timer-raden
  // den ble ført sammen med, så mobilens rediger-inngang finner igjen «radens»
  // maskin (vis/rediger, ikke dupliser). NULL = ført FØR koblingen fantes; kan
  // IKKE utledes i ettertid uten å gjette (ingen backfill, ingen heuristisk
  // bøtte-matching). Null-rader beholder dagens søsken-rad-oppførsel og
  // redigeres inline via maskin-seksjonen.
  sheetTimerId      String?  @map("sheet_timer_id")
  vehicleId         String   @map("vehicle_id") // svak FK → maskin.equipment (db-maskin)
  // T.2 (PR 1B, 2026-05-11) — Per-rad prosjekttilhørighet. NOT NULL etter backfill i PR 1A.
  projectId         String   @map("project_id")
  byggeplassId      String?  @map("byggeplass_id")
  // T.4 — Per-rad tid HH:MM.
  fraTid            String?  @map("fra_tid")
  tilTid            String?  @map("til_tid")
  // T7-4a (2026-05-16) — ECO på maskin-rad. Maskin følger samme prosjekt+ECO-gruppe
  // som arbeidstimer den hører til (per T.7 låst 2026-05-16). Svak FK uten @relation
  // (A.20-mønster — kjernen-tabellen external_cost_objects ligger utenfor db-timer).
  externalCostObjectId String? @map("external_cost_object_id")
  timer             Decimal  @db.Decimal(6, 2)
  mengde            Decimal? @db.Decimal(12, 2)
  enhet             String?  // m, m2, m3, kg, tonn, stk
  attestertSnapshot Json?    @map("attestert_snapshot") // Pris-snapshot ved attestering — null inntil Equipment-prising er spec'd (Fase 1+)
  // T.3 — Per-rad attestering. "pending" | "attestert" | "returnert" | "erstattet".
  // T7-2b2: "erstattet" + parentRadId markerer rediger-erstattede rader.
  attestertStatus   String?  @default("pending") @map("attestert_status")
  attestertAvUserId String?  @map("attestert_av_user_id") // svak FK → users
  attestertVed      DateTime? @map("attestert_ved") @db.Timestamptz()
  parentRadId       String?  @map("parent_rad_id") // T7-2b2 svak selvreferanse
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  sheet DailySheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([sheetId])
  @@index([sheetTimerId])
  @@index([vehicleId])
  @@index([projectId])
  @@index([byggeplassId])
  @@index([externalCostObjectId])
  @@index([attestertStatus])
  @@index([parentRadId])
  @@map("sheet_machines")
  @@schema("timer")
}

// ==========================================================================
//  SheetRadHistorikk — write-only audit av erstattede rad-versjoner
//  (T7-2b-oppfølger 2026-07-13). Ved firma-admin rediger/splitt FLYTTES
//  originalraden hit (INSERT snapshot + DELETE fra hovedtabell i samme tx)
//  i stedet for å settes attestertStatus="erstattet" i hovedtabellen — slik
//  at lesere (særlig mobil-pull hentEndringerSiden) ikke kan lekke audit-
//  rader (×N-duplikater). Felles tabell m/ JSON-snapshot: de tre kilde-
//  tabellene har ulik kolonneform, og historikk leses aldri for beregning
//  (kun revisjonsspor), så snapshot er robust mot fremtidig kolonne-drift.
//  radType = "timer" | "tillegg" | "maskin". originalRadId + parentRadId
//  bevarer lenke-kjeden (ny rad.parentRadId → historikk.originalRadId).
//  Svake String-felt uten @relation (A.20 cross-modul-mønster).
//  ⚠️ snapshot-form-divergens (ikke-blokkerende): engangs-backfill i migreringen
//  bruker to_jsonb(t.*) → snake_case-nøkler; runtime bruker JSON.stringify(rad)
//  → camelCase-nøkler. Uskadelig (write-only) — fremtidig audit-leser må tåle
//  begge. Se timer.md § per-rad-attestering.
// ==========================================================================

model SheetRadHistorikk {
  id                String    @id @default(uuid())
  radType           String    @map("rad_type") // "timer" | "tillegg" | "maskin"
  originalRadId     String    @map("original_rad_id") // id-en raden hadde i hovedtabellen
  sheetId           String    @map("sheet_id") // for oppslag per dagsseddel
  parentRadId       String?   @map("parent_rad_id") // bevart parent-lenke (null = original/helt ny)
  snapshot          Json // full rad-tilstand ved flytting (Decimal→streng, Date→ISO)
  erstattetAvUserId String?   @map("erstattet_av_user_id") // svak FK → users
  erstattetVed      DateTime  @default(now()) @map("erstattet_ved") @db.Timestamptz()
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([sheetId])
  @@index([originalRadId])
  @@index([radType])
  @@map("sheet_rad_historikk")
  @@schema("timer")
}

// ==========================================================================
//  EksportOppsett — lagrede utskriftsmaler for timer-rapport (printmotor fase 3)
//  Lagrer en VISNING (radTyper + format i JSON), IKKE dokumentstruktur — derfor
//  IKKE ReportTemplate/OrganizationTemplate (fabel-vedtak: ikke et tredje
//  mal-begrep; se designnotat-eksportvalg rev 3 + migrering-reporttemplate.md).
//  db-timer er rett datalag: oppsettet er timer-rapport-spesifikt.
//
//  To nivåer via nullable eierId: null = firmamal (alle i firmaet leser; kun
//  firma-admin skriver), satt = personlig (kun eieren ser/redigerer). basertPaId
//  binder «Lagre som min» til firmamalen den ble kopiert fra — svakt selvref-felt
//  UTEN Prisma @relation (db-maskin cross-modul-mønster); «SetNull ved sletting»
//  håndheves i slett-prosedyren (nuller basertPaId på pekende kopier), ikke av en
//  FK. Ingen sync: kopien er bevisst en frossen kopi.
//
//  Innebygde maler (Full eksport osv.) er KODE, ikke rader her — ingen seed-drift.
//  configVersion lar config-formen vokse (grupperings-fase 4: per ansatt/prosjekt
//  + fakturatopptekst) uten å migrere radene.
//  Svake String-FK-er: organizationId → organizations.id, opprettetAvId → users.id.
// ==========================================================================

model EksportOppsett {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id") // svak FK → organizations.id
  name           String
  config         Json // v2: { radTyper[], format:"xlsx"|"pdf", mottaker:"intern"|"ekstern", gruppering:"ingen"|"ansatt"|"prosjekt", orientering:"auto"|"staaende"|"liggende", topptekst:{linjer:string[]}|null }
  configVersion  Int      @default(1) @map("config_version") // 1 leses med v1-defaults; fase 4 skriver 2 (ingen migrering — JSONB)
  eierId         String?  @map("eier_id") // null = firmamal; satt = personlig (svak FK → users.id)
  basertPaId     String?  @map("basert_pa_id") // firmamalen «Lagre som min» ble kopiert fra (SetNull i slett-prosedyren)
  opprettetAvId  String   @map("opprettet_av_id") // svak FK → users.id (attribusjon)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([basertPaId])
  @@map("eksport_oppsett")
  @@schema("timer")
}

# syntax=docker/dockerfile:1
# NY-SERVER — sitedoc API (Fastify/tRPC) i monorepo (i prod fra 2026-06-10).
# Build-context = repo-rot. Bygg: docker compose -f docker/docker-compose.yml build sitedoc-api

# ============ libredwg (DWG/DXF→SVG-konverterer, bygges fra kilde) ============
# DWG-1 (2026-10-08): libredwg 0.14 fra GNU-ftp bygges her og KUN binærene + .so
# kopieres inn i runtime (og i Dockerfile.web — tRPC kjører in-process i web, D-M2).
# Ingen apt-pakke finnes (bookworm har den ikke). ODA valgt bort (lukket lisens).
# Tarball pinnes med SHA256; ingen nettverkshenting i runtime. bookworm-base → samme
# glibc som node:20-bookworm-slim, så .so-en er ABI-kompatibel.
FROM debian:bookworm-slim AS libredwg-build
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config curl xz-utils ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ARG LIBREDWG_VERSION=0.14
ARG LIBREDWG_SHA256=62ebb73b984f865960f20ed26619ea5f8789d5e3fd088fa40a2598384da81275
WORKDIR /build
RUN curl -fsSL -o libredwg.tar.xz "https://ftp.gnu.org/gnu/libredwg/libredwg-${LIBREDWG_VERSION}.tar.xz" \
 && echo "${LIBREDWG_SHA256}  libredwg.tar.xz" | sha256sum -c - \
 && tar xf libredwg.tar.xz \
 && cd "libredwg-${LIBREDWG_VERSION}" \
 && ./configure --disable-bindings --disable-python --enable-release --prefix=/usr/local \
 && make -j"$(nproc)" \
 && make install
# DOCKER-SLANK T1 (2026-11-24): strip + samle .so-en med symlenkene intakt. Før kopierte
# `COPY libredwg.so*` hver symlenke som en full fil (3 × 67 MB). `cp -P` beholder lenkene,
# og COPY av en mappe bevarer symlenker. Eget RUN-steg, så make-laget over forblir cachet.
RUN strip --strip-unneeded /usr/local/bin/dwg2dxf /usr/local/bin/dwg2SVG /usr/local/lib/libredwg.so.*.*.* \
 && mkdir -p /out/lib \
 && cp -P /usr/local/lib/libredwg.so* /out/lib/

# ============ Deps (avhengigheter + Prisma-klienter, uten kildekode) ============
FROM node:20-bookworm-slim AS deps
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app
# Build-tid native (prisma engines, sharp, evt. node-gyp)
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ openssl \
    && rm -rf /var/lib/apt/lists/*
# DOCKER-SLANK T2 (2026-11-24): avhengighetsfilene først, kildekoden etterpå. Da gjenbrukes
# install- og generate-lagene (og runtime-laget som kopierer dem) ved ren kodeendring.
# Ingen pakke har install-skript, så install trenger ikke kildekoden. Ny workspace-pakke:
# legg package.json-en til her (glemt fil gir ERR_PNPM_OUTDATED_LOCKFILE, ikke stille feil).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/mobile/package.json apps/mobile/
COPY packages/db/package.json packages/db/
COPY packages/db-maskin/package.json packages/db-maskin/
COPY packages/db-timer/package.json packages/db-timer/
COPY packages/db-varelager/package.json packages/db-varelager/
COPY packages/pdf/package.json packages/pdf/
COPY packages/shared/package.json packages/shared/
COPY packages/ui/package.json packages/ui/
COPY tests/e2e/package.json tests/e2e/
# DOCKER-SLANK T4 (2026-11-24): bare api og det den avhenger av (`...` = workspace-
# avhengighetene db, db-*, pdf, shared), med devDeps: `tsx` er CMD, og prisma-CLI-en i
# db-pakkene trengs av migreringskommandoen i deploy-test.sh. Web (next/swc), mobil (expo/
# react-native) og e2e (playwright) installeres ikke. Alle package.json-ene over må likevel
# med: lockfila beskriver hele workspacet, og `--frozen-lockfile` sjekker mot den.
# Ikke `pnpm deploy`: Prisma-klientene ligger i rot-`node_modules/.prisma`, og migreringen
# trenger workspace-oppsettet.
RUN pnpm install --frozen-lockfile --filter "@sitedoc/api..."
# 4 Prisma-klienter (db, db-maskin, db-timer, db-varelager) — trenger bare skjemaene.
COPY packages/db/prisma/schema.prisma packages/db/prisma/
COPY packages/db-maskin/prisma/schema.prisma packages/db-maskin/prisma/
COPY packages/db-timer/prisma/schema.prisma packages/db-timer/prisma/
COPY packages/db-varelager/prisma/schema.prisma packages/db-varelager/prisma/
RUN pnpm --filter @sitedoc/db exec prisma generate \
 && pnpm --filter @sitedoc/db-maskin exec prisma generate \
 && pnpm --filter @sitedoc/db-timer exec prisma generate \
 && pnpm --filter @sitedoc/db-varelager exec prisma generate

# ============ Build (kildekode + typegate) ============
# Eget stage oppå deps, så runtime kan kopiere avhengighetene (deps) og kildekoden
# hver for seg — deps-laget er uendret ved ren kodeendring.
FROM deps AS build
COPY . .
# `tsc` er typegaten for api (runtime kjører kilden via tsx, ikke dist). DOCKER-SLANK T4:
# `pnpm --filter` i stedet for `turbo build` — turbo er en rot-devDep som den filtrerte
# installen ikke tar med, og ingen av api-ens workspace-avhengigheter har et build-skript
# (turbo sitt ^build var tomt).
RUN pnpm --filter @sitedoc/api build

# ============ Runtime (med native konvertere API-et shell-er ut til) ============
FROM node:20-bookworm-slim AS runtime
ENV NODE_ENV=production
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
RUN apt-get update && apt-get install -y --no-install-recommends \
      poppler-utils tesseract-ocr tesseract-ocr-nor \
      openssl ca-certificates fontconfig \
      python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
# DWG/DXF-konvertering: libredwg-binærene + .so fra build-staget (D-M3). ODA-sporet og
# xvfb er fjernet (DWG-1: ODA valgt bort, xvfb ble kun brukt av ODA; 3D-veiene er ikke i
# bildet ennå — BACKLOG). ldconfig så dwg2dxf/dwg2SVG finner libredwg.so i /usr/local/lib.
COPY --from=libredwg-build /usr/local/bin/dwg2dxf /usr/local/bin/dwg2dxf
COPY --from=libredwg-build /usr/local/bin/dwg2SVG /usr/local/bin/dwg2SVG
COPY --from=libredwg-build /out/lib/ /usr/local/lib/
RUN ldconfig

# ezdxf-motor (DWG_MOTOR=ezdxf, L9 2026-10-11): isolert Python-venv med hash-låste hjul
# (ezdxf 1.4.4 + deps, --require-hashes → ingen uverifisert nedlasting). INERT til
# DWG_MOTOR=ezdxf settes i env (Kenneths steg på test) — da bruker konverterDwg denne
# via EZDXF_PYTHON/EZDXF_RENDER_PY, ellers egen motor. MÅ finnes i BEGGE bilder
# (nettleser-opplasting konverterer i web-containeren, D-M2) — hold i synk med
# Dockerfile.web. DOCKER-SLANK T2: bygges før kildekoden (bare requirements.txt trengs),
# så venv-laget gjenbrukes ved kodeendring. render.py kommer med kildekoden under.
COPY apps/api/src/services/ezdxf/requirements.txt /tmp/ezdxf-requirements.txt
RUN python3 -m venv /opt/ezdxf-venv \
 && /opt/ezdxf-venv/bin/pip install --no-cache-dir --require-hashes \
      -r /tmp/ezdxf-requirements.txt
ENV EZDXF_PYTHON=/opt/ezdxf-venv/bin/python3
ENV EZDXF_RENDER_PY=/app/apps/api/src/services/ezdxf/render.py

WORKDIR /app
# DOCKER-SLANK T2: avhengighetene (stort, cachet) og kildekoden (lite) som egne lag.
# Før var hele /app ett lag på 2,3 GB som ble eksportert på nytt ved hver kodeendring.
COPY --from=deps /app/ ./
COPY . .
# dist er ikke i bruk ved kjøring (CMD kjører kilden via tsx), men kopien gjør runtime
# avhengig av build-staget — ellers ville BuildKit hoppe over tsc-typegaten.
COPY --from=build /app/apps/api/dist ./apps/api/dist
# Bygg-stempel: GIT_SHA + byggtid bakes inn som env og eksponeres via /version.
# Build-arg må re-deklareres i runtime-stega — build-stegets ENV bæres ikke over.
# Fallback tom → ruten viser «dev»/«ukjent» ved lokal dev uten build-arg.
# DOCKER-SLANK (2026-11-24): står SIST med vilje. SHA-en endres ved hver deploy, og en
# ENV-endring ugyldiggjør cachen for alle lag etter den — øverst i staget bygde den apt,
# venv og hele avhengighetslaget på nytt hver gang.
ARG GIT_SHA=
ARG BUILD_TID=
ENV GIT_SHA=${GIT_SHA}
ENV BUILD_TID=${BUILD_TID}
WORKDIR /app/apps/api
EXPOSE 3001
# Repoet kjorer api via tsx (root tsconfig har noEmit -> dist har extensionless ESM-imports som
# `node dist/server.js` ikke resolver). tsx kjorer TS-kilde direkte, slik test-oppsettet gjor.
CMD ["pnpm", "exec", "tsx", "src/server.ts"]

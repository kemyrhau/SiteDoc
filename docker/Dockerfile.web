# syntax=docker/dockerfile:1
# NY-SERVER — sitedoc web (Next.js 14) i monorepo (i prod fra 2026-06-10).
# Bygger api-pakken også (tRPC-typer er devDependency av web). Fett image (web er IKKE standalone ennaa).
# Oppfoelger: sett `output: "standalone"` i apps/web/next.config.mjs for slankere image.

# ============ libredwg (DWG/DXF→SVG, bygges fra kilde) ============
# DWG-1 (2026-10-08): tRPC kjører in-process i web (route.ts importerer appRouter), så
# DWG-konverteringen skjer i web-containeren når opplastingen kommer fra nettleseren (D-M2).
# Derfor MÅ libredwg også ligge her — samme build-stage som Dockerfile.api. SHA256-pinnet,
# ingen runtime-nettverk. Identisk med api-bildets stage (hold dem i synk).
FROM debian:bookworm-slim AS libredwg-build
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config curl xz-utils ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ARG LIBREDWG_VERSION=0.14
ARG LIBREDWG_SHA256=62ebb73b984f865960f20ed26619ea5f8789d5e3fd088fa40a2598384da81275
WORKDIR /build
RUN curl -fsSL -o libredwg.tar.xz "https://ftp.gnu.org/gnu/libredwg/libredwg-${LIBREDWG_VERSION}.tar.xz" \
 && echo "${LIBREDWG_SHA256}  libredwg.tar.xz" | sha256sum -c - \
 && tar xf libredwg.tar.xz \
 && cd "libredwg-${LIBREDWG_VERSION}" \
 && ./configure --disable-bindings --disable-python --enable-release --prefix=/usr/local \
 && make -j"$(nproc)" \
 && make install
# DOCKER-SLANK T1 (2026-11-24): strip + samle .so-en med symlenkene intakt (før: 3 × 67 MB
# fordi `COPY libredwg.so*` gjorde hver symlenke til en full fil). Identisk med Dockerfile.api.
RUN strip --strip-unneeded /usr/local/bin/dwg2dxf /usr/local/bin/dwg2SVG /usr/local/lib/libredwg.so.*.*.* \
 && mkdir -p /out/lib \
 && cp -P /usr/local/lib/libredwg.so* /out/lib/

FROM node:20-bookworm-slim AS build
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app
# python3 make g++ openssl = build-tid native (prisma engines, sharp, node-gyp).
# poppler-utils + tesseract = RUNTIME: tRPC kjorer in-process i web (route.ts importerer
# appRouter), saa tRPC-prosedyrer som shell-er ut til pdftoppm (PDF-tegninger, tegning.ts)
# og tesseract (OCR, ftd-prosessering.ts) trenger binaerene i DETTE imaget. Dockerfile.web
# er ett-stegs (build ER runtime), saa de maa staa her. xvfb er UTELATT med vilje — den
# hoerte til ODA-DWG-veien (fjernet i DWG-1) og 3D (utsatt, BACKLOG).
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv make g++ openssl \
      poppler-utils tesseract-ocr tesseract-ocr-nor \
    && rm -rf /var/lib/apt/lists/*
# DWG-1: libredwg-binærene + .so fra build-staget (D-M2 — konvertering skjer også her).
COPY --from=libredwg-build /usr/local/bin/dwg2dxf /usr/local/bin/dwg2dxf
COPY --from=libredwg-build /usr/local/bin/dwg2SVG /usr/local/bin/dwg2SVG
COPY --from=libredwg-build /out/lib/ /usr/local/lib/
RUN ldconfig
# ezdxf-motor (DWG_MOTOR=ezdxf, L9 2026-10-11): isolert Python-venv med hash-låste hjul.
# Nettleser-opplasting konverterer i web-containeren (D-M2), så ezdxf MÅ ligge her også.
# INERT til DWG_MOTOR=ezdxf settes i env. Identisk venv-oppsett som Dockerfile.api —
# hold i synk. DOCKER-SLANK T2: bare requirements.txt før kildekoden, så venv-laget
# gjenbrukes ved kodeendring; render.py kommer med `COPY . .` under.
COPY apps/api/src/services/ezdxf/requirements.txt /tmp/ezdxf-requirements.txt
RUN python3 -m venv /opt/ezdxf-venv \
 && /opt/ezdxf-venv/bin/pip install --no-cache-dir --require-hashes \
      -r /tmp/ezdxf-requirements.txt
ENV EZDXF_PYTHON=/opt/ezdxf-venv/bin/python3
ENV EZDXF_RENDER_PY=/app/apps/api/src/services/ezdxf/render.py
# DOCKER-SLANK T2 (2026-11-24): avhengighetsfilene først, kildekoden etterpå, så install-
# og generate-lagene (~2,4 GB) gjenbrukes ved ren kodeendring. Ingen pakke har install-
# skript. Ny workspace-pakke: legg package.json-en til her og i Dockerfile.api (glemt fil
# gir ERR_PNPM_OUTDATED_LOCKFILE, ikke stille feil).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/mobile/package.json apps/mobile/
COPY packages/db/package.json packages/db/
COPY packages/db-maskin/package.json packages/db-maskin/
COPY packages/db-timer/package.json packages/db-timer/
COPY packages/db-varelager/package.json packages/db-varelager/
COPY packages/pdf/package.json packages/pdf/
COPY packages/shared/package.json packages/shared/
COPY packages/ui/package.json packages/ui/
COPY tests/e2e/package.json tests/e2e/
RUN pnpm install --frozen-lockfile
COPY packages/db/prisma/schema.prisma packages/db/prisma/
COPY packages/db-maskin/prisma/schema.prisma packages/db-maskin/prisma/
COPY packages/db-timer/prisma/schema.prisma packages/db-timer/prisma/
COPY packages/db-varelager/prisma/schema.prisma packages/db-varelager/prisma/
RUN pnpm --filter @sitedoc/db exec prisma generate \
 && pnpm --filter @sitedoc/db-maskin exec prisma generate \
 && pnpm --filter @sitedoc/db-timer exec prisma generate \
 && pnpm --filter @sitedoc/db-varelager exec prisma generate
COPY . .
# API_PORT bakes inn i Next routes-manifest (/api/upload(s)-rewrites) ved BUILD-tid og MÅ
# matche API-ens interne PORT per miljø (prod 3001 / test 3301). Runtime-env er for sent —
# manifesten er allerede generert. Settes via build-arg fra compose.
ARG API_PORT=3001
ENV API_PORT=${API_PORT}
# NEXT_PUBLIC_NY_NAV_DEFAULT bakes inn i klient-bundelen ved BUILD-tid (NEXT_PUBLIC → runtime-env
# er for sent). Kun redesign-stacken setter "1" (via build-arg) → ny nav default-på der. Usatt
# (prod/test) = "av". Se docker-compose.redesign.yml + docs/redesign/steg-viii-kunderunde.md.
ARG NEXT_PUBLIC_NY_NAV_DEFAULT=
ENV NEXT_PUBLIC_NY_NAV_DEFAULT=${NEXT_PUBLIC_NY_NAV_DEFAULT}
# Bygg-stempel: NEXT_PUBLIC_* bakes inn i klient-bundelen ved BUILD-tid (runtime-env
# er for sent). Innstillinger-siden viser en diskret linje. Usatt (lokal dev) → «dev».
ARG NEXT_PUBLIC_BUILD_SHA=
ENV NEXT_PUBLIC_BUILD_SHA=${NEXT_PUBLIC_BUILD_SHA}
ARG NEXT_PUBLIC_BUILD_TID=
ENV NEXT_PUBLIC_BUILD_TID=${NEXT_PUBLIC_BUILD_TID}
# NEXT_PUBLIC_TEGNING_MOTOR (arbeidstegning leveranse 1, 🟡 bak flagg): FAKTISKE
# kill-switchen for dxf-viewer-visningen bakes inn ved BUILD-tid (samme to-var-mønster
# som over) — server-flaggets TEGNING_MOTOR (runtime, api+web, se infrastruktur.md)
# avgjør kun om NYE konverteringer produserer artefaktene. Usatt (prod) = av.
ARG NEXT_PUBLIC_TEGNING_MOTOR=
ENV NEXT_PUBLIC_TEGNING_MOTOR=${NEXT_PUBLIC_TEGNING_MOTOR}
# DOCKER-SLANK T5 (2026-11-24): `pnpm --filter` i stedet for `turbo build --filter`, som
# også kjørte api-`tsc` (^build, ~46 s). Web bruker ikke api-dist — tRPC-ruten importerer
# api-kilden via webpack, og `next build` typesjekker den. api-imaget beholder tsc-gaten.
RUN pnpm --filter @sitedoc/web build

ENV NODE_ENV=production
ENV PORT=3100
WORKDIR /app/apps/web
EXPOSE 3100
# `next start` respekterer PORT-env
CMD ["pnpm", "start"]
